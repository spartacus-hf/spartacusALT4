/* Settings help, two lines split at '|' (UI_SettingHelp). Edit here, then
 * run tools/gen_help_text.py: it packs this into Core/Src/ui_help_packed.inc,
 * and validate_current.py checks the two agree. One entry per setting;
 * HELP_NONE is what a setting without one shows, HELP_BYPASSED what the
 * voice tools show while USB CLEAN bypasses them. */

HELP(HELP_NONE, "No description available.")
HELP(HELP_BYPASSED, "BYPASSED by USB CLEAN for USB input.|Turn USB CLEAN OFF to hear this.")
HELP(SET_UI_MODE, "USB, LSB, CW, AM or FM: transmit mode,|sideband and receiver change together.")
HELP(SET_UI_BAND, "Band preset. The knob tunes from there;|a click on the tuning screen sets the step.")
HELP(SET_UI_STEP, "How far one knob detent tunes. On the|tuning screen a click cycles 10 Hz..10 kHz.")
HELP(SET_UI_ROTATION, "Turns the picture 180 degrees for the|way the display sits in the case. Save.")
HELP(SET_UI_FKEY_PIN, "Second key on the encoder board (PC14): BACK.|Held: home. Held + knob: band. Save.")
HELP(SET_HOME_METER, "S-meter / TX level bar on home.")
HELP(SET_HOME_HINTS, "Knob and button hints in the home footer.")
HELP(SET_SHORTCUT_UP, "Hold UP on the home screen.|BAND/MODES open that settings-row item.")
HELP(SET_SHORTCUT_DOWN, "Hold DOWN on the home screen.|FREQ opens frequency entry.")
HELP(SET_REV1_CAL_CODE, "Raw DAC test code, capped at 1024.|Start at 64 and measure before increasing.")
HELP(SET_REV1_CAL_BIAS, "Run the PIN bias buck 5s, RF pins low.|30 mA: about 0.86V across R75 and R76.")
HELP(SET_REV1_CAL_A, "Apply raw DAC code for 5s with RF low.|Requires the matching ENV jumper setting.")
HELP(SET_REV1_CAL_B, "Apply raw DAC code for 5s with RF low.|Requires the matching ENV jumper setting.")
HELP(SET_REV1_CAL_RX, "Inject a weak HRTIM test carrier for 5s.|A path check; RX IQ CAL is the measurement.")
HELP(SET_REV1_RXCAL, "Receive only. TEST_CLK one HRTIM tick off the LO:|measures QSD I/Q balance and image rejection. 50 ohm load.")
HELP(SET_REV1_RXCAL_APPLY, "Take the measured I/Q gain, phase and invert.|Save settings to keep them.")
HELP(SET_REV1_DRIVER_A, "Select the fitted driver for branch A.")
HELP(SET_REV1_DRIVER_B, "Select the fitted driver for branch B.")
HELP(SET_REV1_DRAIN_A, "Branch A drain jumper, as fitted.|ENV = shaping circuit, VIN = direct.")
HELP(SET_REV1_DRAIN_B, "Branch B drain jumper, as fitted.|Both must match; VIN is outphasing only.")
HELP(SET_REV1_BUTTONS, "ON for jumper to 3.3V; OFF for GND.|Relearned from the first key press.")
HELP(SET_REV1_SW4, "Action for panel key SW4 (PD5). MODE cycles|USB/LSB/CW/AM/FM; POWER needs a 3s hold.")
HELP(SET_REV1_SW5, "Action for panel key SW5 (PD6). MODE cycles|USB/LSB/CW/AM/FM; POWER needs a 3s hold.")
HELP(SET_REV1_ENC_A, "Encoder phase A pin on JP20/JP7.|OFF disables the encoder.")
HELP(SET_REV1_ENC_B, "Encoder phase B pin on JP20/JP7.|Must differ from the A and OK pins.")
HELP(SET_REV1_ENC_SW, "Encoder push switch: click selects, hold 0.6s|goes back; hold and turn moves the tune step.")
HELP(SET_REV1_ENC_HIGH, "ON if the encoder common goes to 3.3V.|OFF is the usual common to GND.")
HELP(SET_REV1_ENC_REVERSE, "Swap which way the knob counts.|Use if up and down are inverted.")
HELP(SET_REV1_ENC_NOPULL, "ON only if the encoder has its own pulls.|OFF uses the internal pull.")
HELP(SET_REV1_ENC_DETENT, "Quadrature edges per knob step.|4 suits a normal detented encoder.")
HELP(SET_REV1_BACKLIGHT, "LCD backlight brightness.|5 % minimum, so the screen stays readable.")
HELP(SET_REV1_VOLUME, "Headphone level, heard as you turn.|0 is MUTED. Start low with headphones.")
HELP(SET_REV1_RX_MODE, "Receiver demodulation only. MODE sets it|together with the transmitter.")
HELP(SET_REV1_MIC, "USB or one of three analog microphone inputs.")
HELP(SET_REV1_MIC_GAIN, "Analog microphone digital input gain.")
HELP(SET_REV1_USB_IQ, "ON: stereo I/Q. OFF: demodulated audio.")
HELP(SET_REV1_ENV_MODE, "Requires ENV jumpers and measured DAC scaling.")
HELP(SET_REV1_BIAS, "PIN diode TX bias per diode (QMX: 30).|5 = bias buck off, about 4 mA from 5V.")
HELP(SET_REV1_BIAS_LIMIT, "TX_BIAS overvoltage trip while the buck runs.")
HELP(SET_REV1_VIN_LIMIT, "Supply protection threshold; maximum 14.7V including supply tolerance.")
HELP(SET_REV1_ENV_LIMIT, "Maximum commanded drain voltage.")
HELP(SET_REV1_ENV_A, "Measured DAC codes per volt at branch A drain.")
HELP(SET_REV1_ENV_B, "Measured DAC codes per volt at branch B drain.")
HELP(SET_REV1_SWR, "300 means SWR 3:1; requires bridge calibration.")
HELP(SET_REV1_FWD_ZERO, "Forward detector voltage at zero RF.")
HELP(SET_REV1_REV_ZERO, "Reverse detector voltage at zero RF.")
HELP(SET_REV1_FWD_GAIN, "Forward detector calibration scale.")
HELP(SET_REV1_REV_GAIN, "Reverse detector calibration scale.")
HELP(SET_REV1_AUX, "Bits 1/2/4: TIP/RING2/RING1.|Selected contacts pull low during TX.")
HELP(SET_REV1_PD, "Negotiate on the separate USB power connector.")
HELP(SET_REV1_PD_MV, "Fixed or PPS target; never above 14V.")
HELP(SET_REV1_PD_MAX, "Highest volts to accept when no offer reaches|PD REQUEST MV. Excess is burnt in the 5V regulator.")
HELP(SET_REV1_PD_MA, "Current request limited by source capability.")
HELP(SET_REV1_PD_RD, "OFF with R3/R4 5.1k fitted (default).|ON only if removed: no USB-C cold start.")
HELP(SET_REV1_PD_FIX, "Starts PD on R3/R4.|May cycle VBUS.")
HELP(SET_REV1_IQ_I, "Receiver amplitude calibration for I.")
HELP(SET_REV1_IQ_Q, "Receiver amplitude calibration for Q.")
HELP(SET_REV1_IQ_PHASE, "Subtract I times this factor from Q.")
HELP(SET_REV1_IQ_INVERT, "OFF by design. ON only if USB|signals are heard in LSB mode.")
HELP(SET_REV1_LPF0, "QMX+ LPF_0 160m: L506 4.42uH, L511 3.54uH.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_LPF1, "QMX+ LPF_1 80+60m: L508 1.83uH, L512 1.55uH.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_LPF2, "QMX+ LPF_2 40+30m: L510 1.03uH, L513 866nH.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_LPF3, "QMX+ LPF_3 20/17/15m: L515 518nH, L516 435nH.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_LPF4, "QMX+ LPF_4 12/11/10m: L517 313nH, L518 268nH.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_LPF_TX0, "No TX below: 2nd/3rd harmonics pass the LPF.|QMX+ 1.70/3.45/6.30/12.2/20.5. 0 = no TX.")
HELP(SET_REV1_LPF_TX1, "No TX below: 2nd/3rd harmonics pass the LPF.|QMX+ 1.70/3.45/6.30/12.2/20.5. 0 = no TX.")
HELP(SET_REV1_LPF_TX2, "No TX below: 2nd/3rd harmonics pass the LPF.|QMX+ 1.70/3.45/6.30/12.2/20.5. 0 = no TX.")
HELP(SET_REV1_LPF_TX3, "No TX below: 2nd/3rd harmonics pass the LPF.|QMX+ 1.70/3.45/6.30/12.2/20.5. 0 = no TX.")
HELP(SET_REV1_LPF_TX4, "No TX below: 2nd/3rd harmonics pass the LPF.|QMX+ 1.70/3.45/6.30/12.2/20.5. 0 = no TX.")
HELP(SET_REV1_LPF_QMXP, "Restore 2.5/5.6/10.3/21.45/28.33 MHZ edges|and the QMX+ TX MIN floors.")
HELP(SET_REV1_BPF0, "U10 ch0: C403 39pF, L401a tap. 15m.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_BPF1, "U10 ch1: C401 56pF, L401a 24t. 20m+17m.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_BPF2, "U10 ch2: C404 150pF, L401b tap. 30m.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_BPF3, "U10 ch3: C402 220pF, L401b 34t. 60+40m.|Upper edge; the lowest covering edge wins.")
HELP(SET_REV1_BPF_SWEEP, "Receive only. Chopped TEST_CLK through LPF+BPF,|4-28MHZ x 4 filters. Needs LPF edges. CSV to SD.")
HELP(SET_REV1_BPF_APPLY, "Use the crossovers found by the last sweep.|Save settings to keep them.")
HELP(SET_REV1_BPF_QMX, "Restore 8.5 / 13.5 / 18.5 / 28.33 MHZ edges|for the QMX 60-15m BPF set.")
HELP(SET_REV1_QUAL, "TX interlock, not a setting: bits 1/2/4/8/16|say which LPF you checked on a spectrum analyser.")
HELP(SET_REV1_SELFTEST, "Checks supply, clock, storage, filters and|receive. Safe: never transmits, no antenna needed.")
HELP(SET_REV1_SELFTEST_PANEL, "As SELF TEST, and waits for you to work every|button and turn the encoder both ways.")
HELP(SET_REV1_SELFTEST_ARM, "Allows the PIN bias and envelope ramp tests|on the next run. Pull JP10/JP11 drain jumpers first.")
HELP(SET_REV1_USB_DIAG, "Re-enumerates USB as a serial console for a PC.|USB audio stops until you leave it.")
HELP(SET_REV1_CONFIRM, "Confirm driver, jumpers, filters and calibration.|Save settings to retain this setup.")
HELP(SET_SIDEBAND, "Selects USB or LSB for SSB modes.|Also selects matching calibration table.")
HELP(SET_TX_BW, "SSB transmit audio passband.|Narrower values reduce occupied width.")
HELP(SET_SSB_BIAS, "UNVALIDATED nonlinear envelope bias.|RF-inhibited diagnostic image only.")
HELP(SET_SSB_ANA, "WEAVER is the stable default.|H12P EXP is opt-in for comparison.")
HELP(SET_SSB_CE, "UNVALIDATED nonlinear envelope curve.|Not CESSB or a calibration correction.")
HELP(SET_TH_LAW, "Experimental amplitude law.|LEGACY is inverted-envelope diagnostic only.")
HELP(SET_CE_MIX, "Experimental envelope-curve blend.|Requires spectrum and IMD validation.")
HELP(SET_CE_FLOOR, "Experimental RF envelope floor.|Raises low-level modulation nonlinearly.")
HELP(SET_CE_KNEE, "Experimental envelope-curve knee.|RF-inhibited diagnostic image only.")
HELP(SET_LOW_CUT, "SSB low-frequency audio cut.|Reduces rumble and DC-like content.")
HELP(SET_GATE, "Audio noise gate threshold.|Zero disables gate action.")
HELP(SET_OUTPH_SSB_CAP, "SSB maximum outphase theta.|Lower values compress low envelopes instead of deep nulling.")
HELP(SET_FM_DEV, "Peak deviation command before limiter.|Home/diagnostics show the active value.")
HELP(SET_FM_PRESET, "Sets NFM 2.5k, FM 5k, or test 7.5k.|Direct deviation edits select USER.")
HELP(SET_FM_GAIN, "Gain before bounded pre-emphasis.|Reduce it if the FM limiter counts rise.")
HELP(SET_FM_TEST_TONE, "Replaces USB input with an internal 1k tone.|Use only for deviation measurement.")
HELP(SET_OUTPH_FM_THETA, "FM fixed carrier theta.|Hardware cap reduces it automatically on high bands.")
HELP(SET_AM_PROFILE, "EFFIC is conservative and protected.|LIN TEST uses literal relative depth.")
HELP(SET_AM_CARRIER, "Outphasing AM carrier level.|AM envelope exists after branch combining.")
HELP(SET_AM_DEPTH, "EFFIC sets conservative envelope swing.|LIN TEST sets relative AM depth.")
HELP(SET_OUTPH_AM_CAP, "AM maximum outphase theta.|Limits negative-peak branch fighting.")
HELP(SET_CORDIC, "Use hardware CORDIC when available.|Fallback is software math.")
HELP(SET_USB_CLEAN, "Bypasses voice DSP for USB input.|Turn OFF to process USB like mic audio.")
HELP(SET_USB_VOX, "OFF: USB audio transmits only on a CAT TX,|as QMX. ON: any USB audio keys the radio.")
HELP(SET_DIGI_TONE, "ON: DIGI sends the measured tone as a clean|full-power carrier, as QMX, any PC level.|OFF: linear SSB, power follows the audio.")
HELP(SET_USB_GAIN, "Input gain before the selected modulator.|Keep headroom to avoid limiter/clamp.")
HELP(SET_USB_CHAN, "Selects USB audio channel source.|AVG is a linear mono sum.")
HELP(SET_DSP_MATH, "Chooses DSP math path.|LEGACY is diagnostic and may underrun.")
HELP(SET_GAIN_TELEM, "Gain telemetry detail level.|LIVE updates more often and costs more UI.")
HELP(SET_RF_METRIC, "RF envelope metric calculation.|FAST reduces CPU, EXACT is reference.")
HELP(SET_PROFILE, "Applies a preset to voice DSP.|USBHI is clean wide USB SSB.")
HELP(SET_FREQ, "Requested carrier frequency.|May retune HRTIM clock when needed.")
HELP(SET_DRIVE, "Global audio-mode RF drive.|Use lower values for PA protection.")
HELP(SET_MUTE, "Software transmit mute.|Renderer outputs safe null carrier.")
HELP(SET_SAVE, "Saves the settings now. On the SD card they|also save themselves 2 s after a change.")
HELP(SET_CW_MODE, "IAMBIC B: a squeeze alternates dits and|dahs. STRAIGHT follows the lever.")
HELP(SET_CW_WPM, "Paddle speed in words per minute. A|change waits for the mark keyed now.")
HELP(SET_CW_SWAP, "Swaps the DIT and DAH levers. Dits are|usually on the thumb side.")
HELP(SET_CW_WEIGHT, "Mark against space. 50 is standard;|higher is heavier, speed unchanged.")
HELP(SET_CW_AUTOSPACE, "Holds the gap after a character to 2-4|dits, so letters do not run together.")
HELP(SET_CW_CURTIS_DIT, "During a dit, DAH is remembered after|this %. Higher forgives; 0 is classic B.")
HELP(SET_CW_CURTIS_DAH, "During a dah, DIT is remembered after|this %. Higher forgives; 0 is classic B.")
HELP(SET_CW_LATENCY, "A tap of the same lever counts after|this many eighths of a dit. 0: at once.")
HELP(SET_CW_BREAKIN, "SEMI: RX returns 1+TAIL dits after key-up.|FULL: RX between characters, ~55 ms slower.")
HELP(SET_CW_TAIL, "SEMI hold after the keyer's last gap, dits.|7 = back 8 dits after key-up (a word gap).")
HELP(SET_CW_PITCH, "Sidetone and received CW tone. Tune a|signal to the sidetone to zero-beat it.")
HELP(SET_CW_RX_BW, "CW receive filter, soft-edged: 700 Hz or|1500 to find stations, 200-400 in a crowd.")
HELP(SET_CW_AGC, "SLOW holds gain 250 ms, then 15 dB/s:|no noise swell between dits. FAST: 80 ms.")
HELP(SET_CW_DECODE, "Decode received CW on the home screen.|Tune the signal to the sidetone pitch.")
HELP(SET_SSB_RX_BW, "SSB receive filter, 300 Hz up to 300 Hz +|width. 2700 is the classic; 1800 in QRM.|DIGI (USB input, DIGI CLEAN): 150-3200 Hz.")
HELP(SET_AM_RX_BW, "AM receive filter, total width.|10 kHz for broadcast, 6 kHz in QRM.")
HELP(SET_RX_AGC, "Voice AGC holds the gain, then recovers:|SLOW 500 ms 10 dB/s, MED 250, FAST 100.|DIGI: USB audio fixed gain as QMX; AGC|on the headphones only.")
HELP(SET_FM_SQUELCH, "FM squelch: audio opens above this channel|level (dBFS). OFF keeps it open.")
HELP(SET_TX_PANEL, "Live power and SWR on the home screen while|transmitting, and for METER HANG after.")
HELP(SET_METER_UPDATE, "How often the power and SWR meter reads,|in ms. QMX updates its meter every 100.")
HELP(SET_METER_HANG, "How long the TX panel stays after TX, ms,|so the last reading can be read.")
HELP(SET_TUNE_PCT, "TX TEST carrier drain, % of full (QMX Tune %).|50 % is a quarter of the power.")
HELP(SET_CW_RAMP, "CW envelope ramp time in ms.|Lower is sharper, higher is softer.")
HELP(SET_CW_DRIVE, "CW carrier body drive.|Separate from voice TX drive.")
HELP(SET_CW_THETA, "CW outphasing phase trim.|Use only for CW PA efficiency tuning.")
HELP(SET_CW_THETA_MODEL, "V633 uses the old narrow keyed theta ramp.|OUTPH sweeps the full outphase law for diagnostics.")
HELP(SET_CW_PRACTICE, "The keyer sounds the sidetone only, no|RF. The trainer does this by itself.")
HELP(SET_CW_DEBOUNCE, "Paddle contact debounce in ms, press and|release. 3 suits most paddles.")
HELP(SET_CW_PDL_PROT, "Master key-safety mode.|OFF bypasses arming, both-key, and stuck blocks.")
HELP(SET_CW_ARM_OPEN, "Required open time before arm sequence.|Used by CW and TX test guard.")
HELP(SET_CW_ARM_PRESS, "Required both-paddles press time.|Part of the arming sequence.")
HELP(SET_CW_ARM_RELEASE, "Required release time after arming press.|Completes paddle guard arm.")
HELP(SET_CW_BOTH_POLICY, "Both-paddle safety action for CW.|Only active when key safety is not OFF.")
HELP(SET_CW_STUCK_MS, "CW stuck-paddle timeout.|Only active when key safety is not OFF.")
HELP(SET_TRAIN_ACTIVITY, "ECHO: hear it, key it back. LISTEN: hear.|LEARN: a new character. FREE: key.")
HELP(SET_TRAIN_CONTENT, "What prompts are made of: characters,|words, abbreviations or call signs.")
HELP(SET_TRAIN_GROUP, "Characters in a random group. One is|best while a character is new.")
HELP(SET_TRAIN_LESSON, "Characters you know, in course order.|The trainer says when to add one.")
HELP(SET_TRAIN_RETRIES, "Repeats of a wrong prompt before the|next. 0 none, 7 until it is right.")
HELP(SET_TRAIN_BOOST, "Characters you miss come up more often|(Morserino-32's adaptive draw).")
HELP(SET_TRAIN_WAIT, "Pause after your last character before|a short answer is judged, seconds.")
HELP(SET_TRAIN_TONE, "A quick double beep for right, one|long beep for wrong.")
HELP(SET_TRAIN_COURSE, "The order characters are taught in.|CUSTOM reads CW/CUSTOM.TXT.")
HELP(SET_TRAIN_OPEN, "Opens the Morse trainer. It never|transmits.")
HELP(SET_TXTEST_BOTH_POLICY, "TX test both-paddle safety action.|Only active when key safety is not OFF.")
HELP(SET_TXTEST_STUCK_MS, "TX test carrier stuck timeout.|Only active when key safety is not OFF.")
HELP(SET_BRANCH_LAW, "Which branch takes +theta when outphasing.|No effect in ENVELOPE drain modulation.")
HELP(SET_CESSB, "UNVALIDATED clip/filter experiment.|RF-inhibited diagnostic image only.")
HELP(SET_CESSB_CLIP, "Experimental clipping threshold.|Not a validated CESSB control.")
HELP(SET_CESSB_ITER, "Invalid repeated streaming passes.|For diagnostic comparison only.")
HELP(SET_COMP, "Voice compressor enable.|Raises average speech level.")
HELP(SET_COMP_MATH, "Compressor detector math.|LUT is lighter, EXACT is reference.")
HELP(SET_COMP_TGT, "Compressor target level.|Lower target leaves more headroom.")
HELP(SET_COMP_RATIO, "Compressor ratio.|Higher values compress speech harder.")
HELP(SET_EQ, "Two-band transmit EQ enable.|Manual EQ marks profile CUSTOM.")
HELP(SET_EQ_BASS, "Transmit bass EQ in dB.|Negative cuts low voice energy.")
HELP(SET_EQ_TREBLE, "Transmit treble EQ in dB.|Positive adds articulation.")
HELP(SET_MICAGC, "Microphone AGC enable.|Stabilizes USB/mic input level.")
HELP(SET_MICAGC_TGT, "AGC target audio level.|Lower target leaves more headroom.")
HELP(SET_MICAGC_MAX, "Maximum AGC gain in dB.|Limits noise lift on weak audio.")
HELP(SET_NG, "Noise gate enable.|Mutes low-level background audio.")
HELP(SET_NG_THR, "Noise gate open threshold.|Set just above idle noise.")
HELP(SET_ALC, "Audio ALC limiter enable.|Protects later RF stages from overload.")
HELP(SET_ALC_CEIL, "ALC output ceiling.|Lower value gives more headroom.")
HELP(SET_CAL_SKEW, "Static differential phase correction.|Added to A and subtracted from C.")
HELP(SET_CAL_VALID, "Marks this band/sideband/backend measured.|Edits clear VALID but preserve preview.")
HELP(SET_CAL_APPLY, "Explicit calibration output/preview switch.|Migrated legacy data always starts OFF.")
HELP(SET_DEADTIME, "Sets rise and fall deadtime together.|Band profile clamps to hardware limit.")
HELP(SET_DEADTIME_RISE, "Rising-edge deadtime only.|Use for asymmetric gate timing.")
HELP(SET_DEADTIME_FALL, "Falling-edge deadtime only.|Use for asymmetric gate timing.")
HELP(SET_AC_OFFSET, "Static A versus C compare offset.|Tunes branch phase skew in ticks.")
HELP(SET_DUTY, "Carrier duty offset in ticks.|Tunes PA switch timing per band.")
HELP(SET_PA_GEOMETRY, "Branch A drive polarity against C.|A INVERTED swaps A push-pull (PA8/PA9).")
HELP(SET_RFEN_ON, "RF enable assert threshold.|Lower turns PA enable on earlier.")
HELP(SET_RFEN_OFF, "RF enable release threshold.|Lower holds enable closer to silence.")
HELP(SET_RFEN_HOLD, "Minimum RF enable hold in frames.|Prevents chatter near threshold.")
HELP(SET_OUTPH_CW_THETA, "CW keyed carrier theta.|Both driver enables follow qualified RF frames.")
HELP(SET_OUTPH_TEST_THETA, "TX test carrier theta.|Keep low for efficient load testing.")
HELP(SET_OUTPH_FALLBACK, "High-band outphase fallback.|COMPRESS allows SSB/AM with reduced envelope range.")
HELP(SET_CLK_POLICY, "PLL choice per frequency. AUTO: RX IF first,|then least TX NCO spur. EXACT: TX first.")
HELP(SET_REF_PPM, "Reference oscillator error, ppm. Measure it|with rev1_diag.py refcal (PC NTP clock).")
HELP(SET_REF_SOURCE, "USB HOST: follow the PC's USB clock (MEMS XO).|LOCAL: own oscillator + REF CAL (TCXO).")
HELP(SET_CLK_PARK_TX, "Stop the TX timers while receiving: they|leak an in-band birdie at the TX grid.")
HELP(SET_CLK_WIDE, "Let AUTO use 153-163 MHz too: lower TX|spurs, RX CPU margin ~3% with USB audio.")
HELP(SET_CLK_PHASE384, "TX phase and NCO updates at 384 kHz: every|192 kHz spur 6 dB lower, more CPU.")
HELP(SET_RX_QCOMB, "Subtract the ADC-locked comb in RX Q|(312-sample pattern). Mostly panadapter.")
HELP(SET_RT_DIAG, "Runtime RF/transport diagnostics.|Adds overhead; keep off normally.")
HELP(SET_CPU_DIAG, "DWT CPU cycle profiler.|Useful for tests, off for normal use.")
HELP(SET_CPU_SCOPE, "GPIO duty-cycle scope on PB7.|Bench-only, off for normal use.")
HELP(SET_SSB_PIPELINE, "SSB render scheduler model.|QMX12 is experimental strict 12 ksps.")
HELP(SET_DBG_BRANCH, "Routes debug output to A, C, or both.|Use only for bench diagnosis.")
HELP(SET_DBG_CAL, "Bypasses calibration math for debug.|Keep OFF for normal calibrated output.")
HELP(SET_TRAIN_LISTEN_WPM, "Character speed of what the trainer|plays: 20 or more learns the sound.")
HELP(SET_TRAIN_PACE_WPM, "Overall speed: longer gaps between|characters (Farnsworth), up to LISTEN.")
HELP(SET_TRAIN_KEY_WPM, "Your keyer's speed in the trainer.|The radio's CW SPEED stays as it is.")
HELP(SET_TRAIN_CAROUSEL, "LICW course: where you join the|carousel, 0 to 13 as on Morserino-32.")
HELP(SET_TRAIN_MANUAL, "ON: the gaps below, in dits, instead|of SPACING WPM.")
HELP(SET_TRAIN_ICS, "Dits between characters with SPACING|IN DITS on. 3 is standard.")
HELP(SET_TRAIN_IWS, "Dits between words with SPACING IN|DITS on. 7 is standard.")
HELP(SET_TRAIN_THINK, "Seconds to start keying an answer|before it counts as missed.")
HELP(SET_TRAIN_SHOW, "How an echo prompt is given: by sound,|as text, or both.")
HELP(SET_TRAIN_ADAPT, "LISTEN WPM up one for a right answer,|down one for a wrong one, this session.")
HELP(SET_TRAIN_MINUTES, "Session length before the summary.|0 runs until you stop.")
HELP(SET_CW_PRESET_M32, "Iambic B with Curtis 75/45, as on the|Morserino-32: forgiving squeezes.")
HELP(SET_CW_PRESET_CLASSIC, "Iambic B with Curtis 0/0: releasing a|squeeze always adds one more element.")
HELP(SET_CW_SPOT, "The sidetone at CW PITCH for 4 s: tune|until the station sounds the same.")
HELP(SET_CW_MEM_REPEAT, "A memory sent to its end comes again|after this many seconds; 0 sends it once.")
HELP(SET_TRAIN_SAVE, "ON: your lessons and scores are kept|on the card. OFF: practise without|changing them (read, never written).")
