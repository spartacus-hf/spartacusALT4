/* The Morse trainer's instructions (ui_trainer.c). The card is needed for
 * every training activity anyway; its errors stay in flash. */
TEXT(TXT_TR_PADDLE_DIT, "Press the lever you want for DITS, the short sound. Most people use the thumb.")
TEXT(TXT_TR_PADDLE_SWAP, "That lever sends DAHS. Press the knob to swap the levers, or press the other lever.")
TEXT(TXT_TR_PADDLE_SQUEEZE, "Now squeeze both levers together: DIT DAH DIT DAH, as long as you hold them.")
TEXT(TXT_TR_PADDLE_RELEASE, "Let go of both levers.")
TEXT(TXT_TR_PADDLE_OK, "Your paddle is ready. Press the knob to go on.")
TEXT(TXT_TR_EXPLORE, "Try the keyer. Hold DIT: dits repeat. Hold DAH: dahs repeat. Squeeze both: they take turns. Do all three to go on.")
TEXT(TXT_TR_LEARN, "A new character: listen and watch its pattern, then key it. Three right in a row and it is yours.")
TEXT(TXT_TR_ECHO, "Listen, then key what you heard. Eight dits erase your answer. A pause sends it.")
TEXT(TXT_TR_LISTEN, "Just listen: each group shows after it has played. A lever pauses and goes on.")
TEXT(TXT_TR_FREE, "Key anything: the trainer writes what it hears. Eight dits take back a word.")
TEXT(TXT_TR_STEP_DONE, "Well done. On to the next step.")
TEXT(TXT_TR_SUMMARY, "Session over. Press the knob for another, hold it to leave.")
TEXT(TXT_TR_ADD, "Ready for the next character: your first tries are 90 % right. Add it from the panel when you want.")
TEXT(TXT_TR_JOINED, "Joined as one letter: keep its elements closer.")
/* The course's steps (tools/cw_pack/steps.txt names them; the pack keeps
 * each as its distance from TXT_TR_PADDLE_DIT, so they stay near it). */
TEXT(TXT_TR_C_FAMILIAR, "Just listen: groups of the characters you know, the new ones often. Each shows after it has played.")
TEXT(TXT_TR_C_DRILL, "Sending drill: key what you see, the same character five times, in an even rhythm.")
TEXT(TXT_TR_C_WORDS, "Words made of your characters (single ones until there are words): listen to all of it, then key it.")
TEXT(TXT_TR_C_MASTER, "Key back what you hear. At 90 % right on the first try the next character comes by itself.")
TEXT(TXT_TR_C_GROUPS, "You know every character. Now groups of three: hear all of it, then key it back.")
TEXT(TXT_TR_C_ABBR, "CW abbreviations as they are used on the air: hear one, key it back.")
TEXT(TXT_TR_C_CALLS, "Call signs, letters and figures together: hear one, key it back.")
TEXT(TXT_TR_C_DONE, "The course is done at full speed. Mixed practice now: characters, words, abbreviations, calls.")

